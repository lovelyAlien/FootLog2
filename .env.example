# 이 파일은 값이 아니라 *이름*의 계약이다. 실제 값은 git이 무시하는 `.env`에만 넣는다.
# (10-01-PLAN.md Task 3 — Phase 10 이후 모든 플랜이 이 이름들을 그대로 소비한다)

# Expo config plugin `@react-native-seoul/kakao-login`의 kakaoAppKey prop으로 주입됨(10-07의
# app.config.js). developers.kakao.com > 내 애플리케이션 > 앱 키 > 네이티브 앱 키.
KAKAO_NATIVE_APP_KEY=

# 클라이언트가 백엔드를 호출할 베이스 URL(10-06의 src/auth/config.ts). EXPO_PUBLIC_ 접두사
# 값은 앱 번들에 그대로 인라인되므로 비밀값을 절대 두지 않는다. 로컬 개발 기본값만 채워둔다 —
# 실기기 검증(10-07) 때는 LAN IP로 바꾼다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 백엔드 HS256 서명 키. 최소 32바이트(`openssl rand -base64 32`). 10-RESEARCH.md Pitfall 2:
# 짧으면 앱이 기동조차 되지 않는다. staging에는 기본값이 없어 미주입 시 기동 실패한다(10-03).
JWT_SECRET=

# Phase 9가 이미 도입한 staging DataSource 환경변수(application-staging.yml).
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
